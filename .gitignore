# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/.runtime/
/outputs/
/work/
/adapters/
/trainer/datasets/
/trainer/.venv/
/trainer/__pycache__/
/tests/__pycache__/
/trainer/corpora/**/__pycache__/

# generated Terraria JSONL artifacts; canonical English data lives in
# trainer/corpora/terraria/data/*.json and is materialized locally by build.py.
/trainer/examples/terraria-training.jsonl
/trainer/examples/terraria-validation.jsonl
/trainer/corpora/terraria/validation.jsonl
/trainer/corpora/terraria/evaluation.jsonl

# Generated units corpus; rebuild deterministically with its versioned build.py.
/trainer/examples/unidades-training.jsonl
/trainer/corpora/unidades/validation.jsonl
/trainer/corpora/unidades/evaluation.jsonl
/trainer/corpora/unidades/challenge.jsonl
/trainer/corpora/unidades/train-audit.jsonl
/trainer/corpora/unidades/validation-eval.jsonl
/trainer/corpora/unidades/results/
