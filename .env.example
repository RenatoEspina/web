# Proveedor soportado por el gateway: vllm u ollama.
# El flujo principal del proyecto usa vLLM para generación.
LLM_PROVIDER=vllm

# URL raíz del servidor local. No agregues /v1 ni /api.
LLM_BASE_URL=http://127.0.0.1:8000

# Debe coincidir con VLLM_MODEL en docker-compose.yml.
LLM_MODEL=Qwen/Qwen3.5-0.8B

# Adaptadores cargados dinámicamente en vLLM que la API permite seleccionar.
# La GUI local actualiza esta variable al cargar/descargar LoRA.
LLM_ADAPTER_MODELS=

# Modelos/adaptadores que deben recibir el master prompt exclusivo de Terraria.
# Los nombres que contienen "terraria" se detectan automáticamente; usa esta
# lista si el adaptador tiene otro nombre, por ejemplo: qwen-es-v1,terraria-v2
LLM_TERRARIA_MODELS=

# Solo es necesario si tu servidor OpenAI-compatible exige una clave.
LLM_API_KEY=

# Parámetros comunes enviados por el adaptador.
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=1.0
LLM_TIMEOUT_MS=120000

# Índice semántico. El flujo principal usa Ollama en CPU para embeddings.
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=120000

# Déjalos vacíos para qwen3-embedding:4b. Para modelos que requieran prefijos,
# configúralos explícitamente antes de indexar documentos.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Límites del índice documental y recuperación.
RAG_MAX_PDF_BYTES=10485760
RAG_MAX_PDF_PAGES=100
RAG_MAX_DOCUMENT_CHARACTERS=400000
RAG_MAX_DOCUMENTS=10
RAG_MAX_WORKSPACES=16
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
RAG_TOP_K=4
RAG_SEMANTIC_WEIGHT=70
RAG_LEXICAL_WEIGHT=30
# Cosine mínimo para que un chunk participe del ranking semántico RRF.
# El valor por defecto está calibrado para el flujo actual con qwen3-embedding:4b.
RAG_MIN_SEMANTIC_SCORE=0.2
RAG_MAX_CONTEXT_CHARACTERS=7000
CAG_MAX_CONTEXT_CHARACTERS=8000

# Déjalo vacío solo si la aplicación permanecerá estrictamente local.
# Antes de exponer el gateway por Cloudflare Tunnel define una clave larga.
APP_TOKEN=

# La aplicación queda accesible únicamente desde este computador.
HOST=127.0.0.1
PORT=3000

# vLLM admite ranks 8/16/32 generados por el entrenador incluido.
VLLM_MAX_LORAS=2
VLLM_MAX_LORA_RANK=32
