# Proveedor soportado por el gateway: vllm u ollama
LLM_PROVIDER=vllm

# URL raíz del servidor local. No agregues /v1 ni /api.
LLM_BASE_URL=http://127.0.0.1:8000

# Debe coincidir con VLLM_MODEL en docker-compose.yml.
LLM_MODEL=Qwen/Qwen3.5-0.8B

# Solo es necesario si tu servidor OpenAI-compatible exige una clave.
LLM_API_KEY=

# Parámetros comunes enviados por el adaptador.
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=1.0
LLM_TIMEOUT_MS=120000

# Recomendado cuando uses Cloudflare Tunnel. Déjalo vacío en una prueba solo local.
APP_TOKEN=cambia-esta-clave

# La aplicación queda accesible únicamente desde este computador.
HOST=127.0.0.1
PORT=3000
