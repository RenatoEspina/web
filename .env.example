# Proveedor soportado por el gateway: vllm u ollama
LLM_PROVIDER=vllm

# URL raíz del servidor local. No agregues /v1 ni /api.
LLM_BASE_URL=http://127.0.0.1:8000

# Debe coincidir con VLLM_MODEL en docker-compose.yml.
LLM_MODEL=Qwen/Qwen3.5-0.8B

# Solo es necesario si tu servidor OpenAI-compatible exige una clave.
LLM_API_KEY=

# Parámetros comunes enviados por el adaptador.
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=1.0
LLM_TIMEOUT_MS=120000

# Índice semántico para RAG/CAG. Por defecto usa el servicio Ollama local,
# separado del modelo generativo configurado arriba.
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=120000

# Déjalos vacíos para qwen3-embedding:4b. Para multilingual-e5-small usa:
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Recomendado cuando uses Cloudflare Tunnel. Déjalo vacío en una prueba solo local.
APP_TOKEN=cambia-esta-clave

# La aplicación queda accesible únicamente desde este computador.
HOST=127.0.0.1
PORT=3000
