{
  "name": "llm-bridge-chat",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3000",
    "tunnel:named": "cloudflared tunnel run llm-bridge",
    "typecheck": "tsc --noEmit",
    "test:node": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests -p 'test_*.py'",
    "test": "npm run build && npm run test:node && npm run test:python",
    "verify": "npm run lint && npm run typecheck && npm test",
    "lint": "bash scripts/sites-env.sh -- eslint .",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "dataset:validate": "python trainer/validate_dataset.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "unpdf": "^1.8.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "fast-uri": "3.1.7"
  },
  "type": "module",
  "displayName": "LLM Bridge Chat"
}
